# Initial values; saved panel settings take precedence.
# plus or vanilla; saved panel selection takes precedence.
SERVER_MODE=vanilla
SITE_URL=https://vanilla.example.com
SITE_TITLE=Vanilla
SERVER_ADDRESS=vanilla.example.com:2466
COMMUNITY_URL=
# Game and query ports: the second must equal the first + 1.
GAME_PORT=2466
GAME_QUERY_PORT=2467
SERVER_NAME=Vanilla
WORLD_NAME=VanillaWorld
SERVER_PASSWORD=CHANGE_ME_GAME_PASSWORD
PANEL_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
SERVER_PUBLIC=1
# Force public listing and add project URL to the advertised name.
# Set to 0 only for a private/local server.
REQUIRE_PUBLIC_LISTING=1
PANEL_BIND=127.0.0.1
PANEL_PORT=8081
COOKIE_SECURE=0
BACKUP_HOURS=6
BACKUP_KEEP=12
TZ=UTC
