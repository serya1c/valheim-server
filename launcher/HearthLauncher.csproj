<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HearthLauncher</AssemblyName>
    <RootNamespace>HearthLauncher</RootNamespace>
    <Version>1.1.1</Version>
    <ApplicationTitle>Hearth Launcher</ApplicationTitle>
    <ApplicationIcon>Assets/hearth.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <PublishTrimmed>false</PublishTrimmed>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="[12.1.4]" />
    <PackageReference Include="Avalonia.Desktop" Version="[12.1.4]" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="[12.1.4]" />
    <PackageReference Include="Avalonia.Headless" Version="[12.1.4]" />
    <Compile Remove="tests/**/*.cs;setup/**/*.cs;setup-tests/**/*.cs" />
    <Compile Remove=".packages/**/*.cs;.build/**/*.cs" />
    <AvaloniaResource Include="Assets/hearth.png" />
  </ItemGroup>
</Project>
